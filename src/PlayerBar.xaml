<UserControl x:Class="ChiliMusic.PlayerBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pr="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
 <StackPanel x:Name="RootPanel">
  <StackPanel x:Name="ControlRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
   <Button Content="&#xE8B1;" Style="{StaticResource IconButton}" Command="{Binding ShuffleCommand}" ToolTip="开启 / 关闭随机播放" Foreground="{DynamicResource MutedBrush}"/>
   <Button Content="&#xE892;" Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip="上一首" Margin="8,2"/>
   <Button Content="{Binding PlayIcon}" Style="{StaticResource CirclePlay}" Command="{Binding ToggleCommand}" ToolTip="播放 / 暂停"/>
   <Button Content="&#xE893;" Style="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip="下一首" Margin="8,2"/>
   <Button Content="{Binding ModeIcon}" Style="{StaticResource IconButton}" Command="{Binding ModeCommand}" ToolTip="{Binding ModeText}" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
  <Slider x:Name="SeekSlider" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}" pr:Thumb.DragStarted="SeekStarted" pr:Thumb.DragCompleted="SeekCompleted" PreviewMouseLeftButtonUp="SeekReleased" IsMoveToPointEnabled="True" ToolTip="拖动定位播放位置"/>
  <DockPanel Margin="0,0,0,4"><TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></DockPanel>
  <DockPanel Visibility="{Binding ShowUtilities,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolVisible}}">
   <Button Content="{Binding FavoriteGlyph}" Command="{Binding FavoriteCommand}" ToolTip="收藏 / 取消收藏" Style="{StaticResource IconButton}" FontFamily="Segoe UI Symbol" FontSize="20"/>
   <Button Content="&#xE767;" Command="{Binding MuteCommand}" ToolTip="{Binding MuteText}" Style="{StaticResource IconButton}" Margin="6,2,0,2"/>
   <TextBlock Text="{Binding Volume,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="10" Margin="8,0,0,0"/>
   <Slider Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="5,0" ToolTip="音量 0–100；滚轮调整" PreviewMouseWheel="VolumeWheel"/>
  </DockPanel>
 </StackPanel>
</UserControl>
