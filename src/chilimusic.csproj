<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>chilimusic</AssemblyName>
    <ApplicationIcon>Resources/player.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Product>chilimusic</Product>
    <Description>本地音乐、Navidrome 与网易云音乐播放器</Description>
    <RootNamespace>ChiliMusic</RootNamespace>
    <Company>Chili</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Use the portable QR renderer; the Windows variant pulls in an older System.Drawing runtime. -->
    <PackageDownload Include="QRCoder" Version="[1.6.0]" />
    <Reference Include="QRCoder"><HintPath>$(NuGetPackageRoot)/qrcoder/1.6.0/lib/net6.0/QRCoder.dll</HintPath></Reference>
    <EmbeddedResource Include="RemoteWeb/*" />
    <Content Include="Native/mpv-2.dll" CopyToOutputDirectory="PreserveNewest" Link="mpv-2.dll" />
    <Content Include="Native/vulkan-1.dll" CopyToOutputDirectory="PreserveNewest" Link="vulkan-1.dll" />
    <Resource Include="Resources/player.ico" />
    <Resource Include="Resources/chilimusic.png" />
    <Resource Include="Resources/Fonts/*.ttf" Condition="'$(IncludeMiSans)' != 'false'" />
  </ItemGroup>
</Project>
