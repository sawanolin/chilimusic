<Window x:Class="ChiliMusic.MiniPlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChiliMusic" Title="chilimusic · 迷你" Width="320" Height="260" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource AppFont}" FontSize="12" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="5"><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.16"/></Border.Effect><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Border MouseLeftButtonUp="ImmersiveClick" Cursor="Hand" ToolTip="沉浸播放" CornerRadius="7" Background="{DynamicResource HoverBrush}" Width="46" Height="46" HorizontalAlignment="Left"><Grid><TextBlock Text="♪" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border CornerRadius="7"><Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding QualityTag}" Foreground="{DynamicResource QualityBrush}" FontSize="9" Margin="0,3,0,0" ToolTip="{Binding AudioInfo}"/></StackPanel><Button Grid.Column="2" Content="&#xE8A7;" Click="Expand" ToolTip="完整播放器" Style="{StaticResource IconButton}" Width="24" Height="26" FontSize="14" VerticalAlignment="Top"/></Grid>
  <local:PlayerBar Grid.Row="1" Margin="0,9,0,0" ShowUtilities="False"/>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,7,0,0"><DockPanel><Button Content="{Binding FavoriteGlyph}" Command="{Binding FavoriteCommand}" Style="{StaticResource IconButton}" Width="26" Height="24" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="收藏"/><Button Content="&#xE8F1;" Click="QueueClick" ToolTip="队列" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="14"/><Button Content="&#xE767;" Command="{Binding MuteCommand}" ToolTip="{Binding MuteText}" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="14"/><Button Content="&#xE713;" Click="SettingsClick" ToolTip="设置" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="14" DockPanel.Dock="Right"/><Button Content="&#xE721;" Click="SearchClick" ToolTip="搜索" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="14" DockPanel.Dock="Right"/><Slider Value="{Binding Volume,Mode=TwoWay}" Minimum="0" Maximum="100" Margin="5,0" VerticalAlignment="Center" PreviewMouseWheel="VolumeWheel"/></DockPanel></Border>
  <TextBlock Grid.Row="3" Text="{Binding LyricText}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" ToolTip="{Binding LyricText}"/><TextBlock Grid.Row="4" Visibility="{Binding HasStatusError,Converter={StaticResource BoolVisible}}" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
 </Grid></Border>
</Window>
